# ==============================================================================
# OPTIMUS AI — ZERO-COST MULTI-PROVIDER LLM ROTATOR CONFIGURATION
# ==============================================================================
# All keys below have generous $0 free tiers.
# Comma-separated multiple keys are supported for automated rate-limit key rotation!
# If no keys are provided, Optimus AI gracefully falls back to local Ollama or
# the built-in deterministic heuristic extractor with 0 errors.
# ==============================================================================

# Priority 1: Google Gemini API (Free Tier at https://aistudio.google.com)
# Supports multiple comma-separated keys for automatic 429 rotation
GEMINI_API_KEY=AIzaSyD_ExampleKey1,AIzaSyD_ExampleKey2

# Priority 2: Groq API (Ultra-fast Llama 3.3 70B with free tier at https://console.groq.com)
GROQ_API_KEY=gsk_ExampleGroqKey1,gsk_ExampleGroqKey2

# Priority 3: OpenRouter Free Router (Free models at https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-v1-ExampleOpenRouterKey

# Priority 4: Local Ollama Fallback (Offline local inference)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
